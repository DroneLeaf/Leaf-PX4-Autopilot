#!/bin/sh
# shellcheck disable=SC2154

# Simulator IMU data provided at 400 Hz
param set-default IMU_INTEG_RATE 400
param set-default EKF2_PREDICT_US 2500

# For simulation, allow registering modes while armed for developer convenience
param set-default COM_MODE_ARM_CHK 1

param set-default COM_DISARM_PRFLT 1000
param set-default COM_DISARM_LAND -1
param set-default MPC_THR_HOVER 0.25

if [ "$PX4_SIMULATOR" = "sihsim" ] || [ "$(param show -q SYS_AUTOSTART)" -eq "0" ]; then
    # Run SIH
    . px4-rc.sihsim

elif [ "$PX4_SIMULATOR" = "gz" ] || [ "$(param show -q SIM_GZ_EN)" = "1" ]; then
    # Run Gazebo (gz)
    . px4-rc.gzsim

elif [ "$PX4_SIM_MODEL" = "jmavsim_iris" ] || [ "$(param show -q SYS_AUTOSTART)" -eq "10017" ]; then
    # Run jMAVSim
    . px4-rc.jmavsim

else
    # Run simulator_mavlink module for interface with gazebo-classic
    . px4-rc.mavlinksim

    param set SYS_AUTOSTART 3011 #TODO This should be ready from the user

    param set-default MC_ROLLRATE_P 0.1
    param set-default MC_ROLLRATE_I 0.0
    param set-default MC_ROLLRATE_D 0.0

    param set-default MC_PITCHRATE_P 0.1
    param set-default MC_PITCHRATE_I 0.0
    param set-default MC_PITCHRATE_D 0.0
fi
